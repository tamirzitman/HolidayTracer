# Google Sheet that holds all the data.
# Copy the id out of the sheet's URL: docs.google.com/spreadsheets/d/<THIS>/edit
SHEET_ID=

# Service account credentials. Create a service account in Google Cloud,
# enable the Google Sheets API, download a JSON key, then share the sheet
# with the service account's address as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Any long random string. Signs the cookie that remembers a phone number.
SESSION_SECRET=

# Leave SHEET_ID empty to run against a local .dev-sheet.json file instead,
# which is handy before the real sheet exists.
